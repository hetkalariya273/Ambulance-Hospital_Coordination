@{
    ViewData["Title"] = "Access Denied";
}

<div class="access-denied-page">

    <div class="access-denied-card">

        <div class="access-denied-icon">
            🔒
        </div>

        <h1>Access Denied</h1>

        <p>
            You don't have permission to access this page.
        </p>

        <p class="sub-text">
            Please log in with an account that has the required role.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-button">
            Go Back
        </a>

    </div>

</div>

<style>
    .access-denied-page {
        min-height: 70vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .access-denied-card {
        width: 100%;
        max-width: 500px;
        padding: 50px 40px;
        text-align: center;
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.12);
    }

    .access-denied-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .access-denied-card h1 {
        margin-bottom: 15px;
        font-size: 32px;
    }

    .access-denied-card p {
        font-size: 17px;
        color: #555;
    }

    .sub-text {
        font-size: 14px !important;
        color: #888 !important;
        margin-bottom: 30px;
    }

    .back-button {
        display: inline-block;
        padding: 12px 25px;
        border-radius: 10px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        font-weight: 600;
    }

    .back-button:hover {
        background: #1d4ed8;
        color: white;
    }
</style>