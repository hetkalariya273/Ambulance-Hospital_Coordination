@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white">
                <div class="ams-stat-icon-wrapper mx-auto mb-4" style="--stat-bg: #fee2e2; --stat-color: #e11d48; width: 72px; height: 72px; font-size: 2.2rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <h2 class="fw-bold text-dark mb-2">Access Restricted</h2>
                <p class="text-muted mb-4">
                    Your authenticated account does not have sufficient role permissions to access this dispatch or coordination resource.
                </p>

                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-ams-primary py-2 fw-bold">
                        <i class="bi bi-house-door-fill me-1"></i> Return to Homepage
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account / Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
