@model AMS.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Patient Registration";
}

<div class="container py-4">

    <!-- Immediate Emergency Request Banner for Distress Callers -->
    <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-3 shadow-sm border-danger mb-4 rounded-3 p-3">
        <div class="d-flex align-items-center gap-3">
            <div class="fs-2 text-danger">
                <i class="bi bi-shield-fill-exclamation"></i>
            </div>
            <div>
                <strong class="fs-6 d-block text-danger">Need an Emergency Ambulance Right Now?</strong>
                <span class="small text-danger-emphasis">
                    Registration is optional in critical trauma cases. You can dispatch an ambulance immediately without an account.
                </span>
            </div>
        </div>

        <a asp-controller="AmbulanceRequest" asp-action="Create" class="btn btn-ams-primary pulse-button px-4 py-2 fw-bold">
            <i class="bi bi-lightning-charge-fill me-1"></i> Request Ambulance Directly
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <!-- Card Header -->
                <div class="card-header bg-dark text-white p-4 text-center border-0" style="background: linear-gradient(135deg, #090d16 0%, #1e1b4b 100%);">
                    <div class="ams-logo-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.6rem;">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-1 text-white">Create Patient Account</h3>
                    <p class="text-white-50 small mb-0">
                        Register for rapid ambulance requests, medical telemetry, and dispatch history
                    </p>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-md-5 bg-white">
                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Full Legal Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-fill text-primary"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="e.g. Jane Doe" autocomplete="name" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Primary Phone Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone-fill text-success"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +1 555-0144" autocomplete="tel" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope-fill text-primary"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="name@domain.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="Password" class="form-label fw-bold">Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-muted"></i></span>
                                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-sm-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-shield-lock-fill text-muted"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-ams-primary w-100 py-3 fs-6 fw-bold mb-3">
                            <i class="bi bi-person-check-fill me-1"></i> Complete Patient Registration
                        </button>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light py-3 text-center border-top">
                    <span class="text-muted small">
                        Already have an account?
                        <a asp-action="Login" class="text-primary fw-bold text-decoration-none">
                            Sign In Here <i class="bi bi-arrow-right"></i>
                        </a>
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
