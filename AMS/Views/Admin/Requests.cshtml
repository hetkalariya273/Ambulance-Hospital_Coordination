@model IEnumerable<AMS.Models.AmbulanceRequest>

@{
    ViewData["Title"] = "Emergency Requests Monitor";
}

<div class="admin-page container py-3">

    <!-- Header & Navigation -->
    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger-subtle text-danger border border-danger-subtle mb-2 small fw-bold">
                <span class="ams-live-dot"></span> System Telemetry Log
            </div>
            <h1 class="ams-page-header-title">
                Emergency Ambulance Requests
            </h1>
            <p class="ams-page-header-subtitle">
                Inspect and track ambulance dispatch calls across the coordination network.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Admin" asp-action="Index" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
            <a asp-controller="AmbulanceRequest" asp-action="Create" class="btn btn-ams-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> New Request
            </a>
        </div>
    </div>

    <!-- Filter Bar Card -->
    <div class="card shadow-sm border mb-4">
        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="fw-bold text-dark small text-uppercase">
                    <i class="bi bi-funnel-fill text-danger me-1"></i> Status Filter:
                </span>

                <div class="btn-group" role="group">
                    <a asp-controller="Admin" asp-action="Requests" asp-route-filter="Active"
                       class="btn btn-sm @(ViewBag.Filter == "Active" ? "btn-danger fw-bold" : "btn-outline-secondary")">
                        Active Dispatches
                    </a>
                    <a asp-controller="Admin" asp-action="Requests" asp-route-filter="Completed"
                       class="btn btn-sm @(ViewBag.Filter == "Completed" ? "btn-success fw-bold" : "btn-outline-secondary")">
                        Completed
                    </a>
                    <a asp-controller="Admin" asp-action="Requests" asp-route-filter="Cancelled"
                       class="btn btn-sm @(ViewBag.Filter == "Cancelled" ? "btn-secondary fw-bold" : "btn-outline-secondary")">
                        Cancelled
                    </a>
                </div>
            </div>

            <div class="text-muted small">
                Showing <strong>@Model.Count()</strong> @ViewBag.Filter.ToString().ToLower() request(s)
            </div>
        </div>
    </div>

    <!-- Requests Table -->
    @if (!Model.Any())
    {
        <div class="card shadow-sm border p-5 text-center my-4">
            <div class="mb-3 text-muted">
                <i class="bi bi-search fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark">No @ViewBag.Filter.ToString() Requests Found</h5>
            <p class="text-muted small col-md-6 mx-auto mb-3">
                There are currently no ambulance requests matching the "@ViewBag.Filter" filter criteria.
            </p>
            <div>
                <a asp-controller="Admin" asp-action="Requests" asp-route-filter="Active" class="btn btn-outline-danger btn-sm">
                    Reset Filter to Active
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border overflow-hidden">
            <div class="table-responsive">
                <table class="ams-table">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Caller / Patient</th>
                            <th>Current Status</th>
                            <th>Emergency Type</th>
                            <th>Request Time</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            var statusBadge = request.Status switch
                            {
                                AMS.Enums.RequestStatus.Requested => "bg-primary text-white",
                                AMS.Enums.RequestStatus.Accepted => "bg-info text-dark",
                                AMS.Enums.RequestStatus.OnTheWay => "bg-warning text-dark",
                                AMS.Enums.RequestStatus.ReachedPatient => "bg-warning text-dark",
                                AMS.Enums.RequestStatus.PatientPickedUp => "bg-primary text-white",
                                AMS.Enums.RequestStatus.GoingToHospital => "bg-primary text-white",
                                AMS.Enums.RequestStatus.ReachedHospital => "bg-info text-dark",
                                AMS.Enums.RequestStatus.Completed => "bg-success text-white",
                                AMS.Enums.RequestStatus.Cancelled => "bg-danger text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td>
                                    <strong class="text-dark">#@request.RequestId</strong>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(request.User?.FullName ?? "Unknown User")</div>
                                    <div class="smaller text-muted">@request.User?.PhoneNumber</div>
                                </td>
                                <td>
                                    <span class="badge @statusBadge rounded-pill px-3 py-1">
                                        @request.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        @request.EmergencyType
                                    </span>
                                </td>
                                <td>
                                    <span class="small text-muted">@request.RequestTime.ToString("dd-MM-yyyy HH:mm")</span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Admin"
                                       asp-action="RequestDetails"
                                       asp-route-id="@request.RequestId"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-eye-fill me-1"></i> Inspect Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
