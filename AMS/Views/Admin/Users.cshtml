@model IEnumerable<AMS.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="admin-page">

    <div class="admin-page-header">

        <div>
            <h2>Manage Users</h2>
            <p>View and manage registered users.</p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            ← Dashboard
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="admin-empty-message">
            No users have been registered yet.
        </div>
    }
    else
    {
        <div class="admin-table-container">

            <table class="admin-table">

                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <td class="user-id">
                                @user.Id
                            </td>

                            <td>
                                @user.FullName
                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>
                                @user.PhoneNumber
                            </td>

                            <td>
                                <a asp-controller="Admin"
                                   asp-action="UserDetails"
                                   asp-route-id="@user.Id"
                                   class="admin-view-button">
                                    View
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
}