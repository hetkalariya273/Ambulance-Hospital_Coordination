@model AMS.Models.Ambulance

@{
    ViewData["Title"] = $"Delete Ambulance - {Model.VehicleNumber}";
}

<div class="ambulance-form-page container py-3">

    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger-subtle text-danger border border-danger-subtle mb-2 small fw-bold">
                <i class="bi bi-exclamation-triangle-fill"></i> Danger Zone
            </div>
            <h1 class="ams-page-header-title text-danger">
                Delete Ambulance Vehicle
            </h1>
            <p class="ams-page-header-subtitle">
                Confirm whether you wish to permanently decommission vehicle <strong>@Model.VehicleNumber</strong> from the emergency fleet.
            </p>
        </div>

        <div>
            <a asp-action="Index" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Ambulances
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border border-danger">
                <div class="card-header bg-danger text-white py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-trash-fill fs-5"></i>
                    <h5 class="mb-0 fw-bold">Confirm Deletion</h5>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning:</strong> Deleting this ambulance will remove it from driver rosters and active emergency telemetry broadcasts.
                    </div>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Vehicle Registration</span>
                            <strong class="fs-5 text-dark">@Model.VehicleNumber</strong>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Current Status</span>
                            <span class="badge bg-secondary rounded-pill px-3 py-1">@Model.Status</span>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Currently Assigned Driver</span>
                            <span class="text-dark">@(Model.Driver?.FullName ?? "Not Assigned")</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="ams-back-btn">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>

                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this ambulance?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="AmbulanceId" />
                            <button type="submit" class="btn btn-danger px-4 py-2 fw-bold">
                                <i class="bi bi-trash-fill me-1"></i> Delete Ambulance
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/ambulance.css" asp-append-version="true" />
}
