```cshtml
@model AmbulanceRequestViewModel
@using AMS.Enums
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Request Ambulance";
}

<h2>Request Ambulance</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EmergencyType" class="form-label"></label>
        <select asp-for="EmergencyType"
                asp-items="Html.GetEnumSelectList<EmergencyType>()"
                class="form-select">
            <option value="">-- Select Emergency Type --</option>
        </select>
        <span asp-validation-for="EmergencyType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PatientCondition" class="form-label"></label>
        <select asp-for="PatientCondition"
                asp-items="Html.GetEnumSelectList<PatientCondition>()"
                class="form-select">
            <option value="">-- Select Patient Condition --</option>
        </select>
        <span asp-validation-for="PatientCondition" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NumberOfPatients" class="form-label"></label>
        <input asp-for="NumberOfPatients"
               type="number"
               min="1"
               max="20"
               class="form-control" />
        <span asp-validation-for="NumberOfPatients" class="text-danger"></span>
    </div>

    <input asp-for="PickupLatitude" type="hidden" id="pickupLatitude" />
    <input asp-for="PickupLongitude" type="hidden" id="pickupLongitude" />

    <div class="mb-3">
        <button type="button" class="btn btn-secondary" id="getLocationBtn">
            Get Current Location
        </button>
        <span id="locationStatus" class="ms-2"></span>
    </div>

    <div id="pickupMap"></div>

    <p class="mt-2">Click the map to select your pickup location.</p>

    <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
        Request Ambulance
    </button>
</form>

@section Scripts {
    <link rel="stylesheet" href="~/css/pickup-map.css" asp-append-version="true" />
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/pickup-map.js" asp-append-version="true"></script>

    <script async
            src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]&loading=async&callback=initPickupMap">
    </script>
}