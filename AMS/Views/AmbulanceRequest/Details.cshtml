
@model AMS.Models.AmbulanceRequest
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Ambulance Request Details";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Ambulance Request Details</h2>
    </div>

    <!-- Request Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Request Information</h5>
        </div>

        <div class="card-body">
            <p>
                <strong>Request ID:</strong>
                #@Model.RequestId
            </p>

            <input type="hidden"
                   id="requestId"
                   value="@Model.RequestId" />

            <p class="mb-0">
                <strong>Status:</strong>
                <span id="requestStatus">@Model.Status</span>
            </p>
        </div>
    </div>

    <!-- Emergency Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Emergency Information</h5>
        </div>

        <div class="card-body">
            <p>
                <strong>Emergency Type:</strong>
                @Model.EmergencyType
            </p>

            <p>
                <strong>Patient Condition:</strong>
                @Model.PatientCondition
            </p>

            <p>
                <strong>Number of Patients:</strong>
                @Model.NumberOfPatients
            </p>

            <p class="mb-0">
                <strong>Request Time:</strong>
                @Model.RequestTime.ToString("dd-MM-yyyy HH:mm")
            </p>
        </div>
    </div>

    <!-- Driver Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Driver Information</h5>
        </div>

        <div class="card-body">
            @if (Model.Driver != null)
            {
                <p>
                    <strong>Driver Name:</strong>
                    @Model.Driver.FullName
                </p>

                <p class="mb-0">
                    <strong>Phone Number:</strong>
                    @Model.Driver.PhoneNumber
                </p>
            }
            else
            {
                <p>
                    <strong>Driver Name:</strong> Not Assigned
                </p>

                <p class="mb-0">
                    <strong>Phone Number:</strong> Not Available
                </p>
            }
        </div>
    </div>

    <!-- Ambulance Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Ambulance Information</h5>
        </div>

        <div class="card-body">
            @if (Model.Ambulance != null)
            {
                <p>
                    <strong>Vehicle Number:</strong>
                    @Model.Ambulance.VehicleNumber
                </p>

                <p class="mb-0">
                    <strong>Ambulance Status:</strong>
                    @Model.Ambulance.Status
                </p>
            }
            else
            {
                <p>
                    <strong>Vehicle Number:</strong> Not Assigned
                </p>

                <p class="mb-0">
                    <strong>Ambulance Status:</strong> Not Assigned
                </p>
            }
        </div>
    </div>

    <!-- Hospital Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Hospital Information</h5>
        </div>

        <div class="card-body">
            @if (Model.Hospital != null)
            {
                <p>
                    <strong>Hospital:</strong>
                    @Model.Hospital.Name
                </p>

                <p>
                    <strong>Address:</strong>
                    @Model.Hospital.Address
                </p>

                <p class="mb-0">
                    <strong>Phone Number:</strong>
                    @Model.Hospital.PhoneNumber
                </p>
            }
            else
            {
                <p class="mb-0">
                    <strong>Hospital:</strong> Not Selected
                </p>
            }
        </div>
    </div>

    <!-- Live Ambulance Tracking -->
    <div class="card shadow-sm mb-4"
         id="patientTrackingData"
         data-tracking-url="@Url.Action("TrackingData", "AmbulanceRequest", new { id = Model.RequestId })">

        <div class="card-header">
            <h5 class="mb-0">Live Ambulance Tracking</h5>
        </div>

        <div class="card-body">

            <p id="patientTrackingStatus" role="status">
                Waiting for ambulance location...
            </p>

            <div class="row mb-3">
                <div class="col-sm-6 mb-2">
                    <div class="border rounded p-3 h-100">
                        <strong>Distance</strong>
                        <div id="patientRouteDistance"
                             class="fs-5 mt-1">--</div>
                    </div>
                </div>

                <div class="col-sm-6 mb-2">
                    <div class="border rounded p-3 h-100">
                        <strong>Estimated Arrival</strong>
                        <div id="patientRouteEta"
                             class="fs-5 mt-1">--</div>
                    </div>
                </div>
            </div>

            <div id="patientLiveMap"
                 role="region"
                 aria-label="Live ambulance map"
                 style="width:100%; height:400px; border-radius:10px;">
            </div>

            <small class="text-muted d-block mt-2">
                Ambulance location refreshes automatically when new GPS
                coordinates are available. ETA and distance are estimates.
            </small>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-controller="Patient"
           asp-action="Index"
           class="btn btn-secondary">
            ← Back
        </a>

        @if (Model.Status == AMS.Enums.RequestStatus.Requested ||
             Model.Status == AMS.Enums.RequestStatus.Accepted ||
             Model.Status == AMS.Enums.RequestStatus.OnTheWay)
        {
            <form asp-action="Cancel"
                  asp-route-id="@Model.RequestId"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to cancel this request?');">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Cancel Request
                </button>
            </form>
        }
    </div>

</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <script src="~/js/patient-request-details.js"
            asp-append-version="true"></script>

    <script src="https://maps.googleapis.com/maps/api/js?key=@(Configuration["GoogleMaps:ApiKey"])&callback=initPatientTrackingMap"
            async
            defer></script>
}
