@model IEnumerable<AMS.Models.AmbulanceRequest>

@{
    ViewData["Title"] = "My Ambulance Requests";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Ambulance Requests</h2>

        <a asp-controller="AmbulanceRequest"
           asp-action="Create"
           class="btn btn-primary">
            Request Ambulance
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not created any ambulance requests yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var request in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h5 class="card-title mb-0">
                                    Request #@request.RequestId
                                </h5>

                                <span class="badge bg-primary">
                                    @request.Status
                                </span>

                            </div>

                            <p class="mb-2">
                                <strong>Emergency:</strong>
                                @request.EmergencyType
                            </p>

                            <p class="mb-2">
                                <strong>Condition:</strong>
                                @request.PatientCondition
                            </p>

                            <p class="mb-2">
                                <strong>Patients:</strong>
                                @request.NumberOfPatients
                            </p>

                            <p class="mb-3">
                                <strong>Requested:</strong>
                                @request.RequestTime.ToString("dd-MM-yyyy HH:mm")
                            </p>

                            <a asp-controller="AmbulanceRequest"
                               asp-action="Details"
                               asp-route-id="@request.RequestId"
                               class="btn btn-outline-primary w-100">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>