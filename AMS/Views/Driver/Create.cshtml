@model AMS.ViewModels.DriverCreateViewModel

@{
    ViewData["Title"] = "Add Driver";
}

<div class="driver-form-page">

    <div class="driver-form-card">

        <h1>Add Driver</h1>

        <p class="form-subtitle">
            Register a new ambulance driver.
        </p>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"></div>

            <div class="driver-form-group">
                <label asp-for="FullName">
                    Full Name
                </label>

                <input asp-for="FullName"
                       placeholder="Enter driver's full name" />

                <span asp-validation-for="FullName"></span>
            </div>

            <div class="driver-form-group">
                <label asp-for="PhoneNumber">
                    Phone Number
                </label>

                <input asp-for="PhoneNumber"
                       placeholder="Enter phone number" />

                <span asp-validation-for="PhoneNumber"></span>
            </div>

            <div class="driver-form-group">
                <label asp-for="LicenseNumber">
                    License Number
                </label>

                <input asp-for="LicenseNumber"
                       placeholder="Enter driving license number" />

                <span asp-validation-for="LicenseNumber"></span>
            </div>

            <div class="driver-form-group">
                <label asp-for="Email">
                    Email
                </label>

                <input asp-for="Email"
                       placeholder="Enter driver's email" />

                <span asp-validation-for="Email"></span>
            </div>

            <div class="driver-form-group">
                <label asp-for="Password">
                    Password
                </label>

                <input asp-for="Password"
                       placeholder="Enter driver's password" />

                <span asp-validation-for="Password"></span>
            </div>

            <div class="driver-form-group">
                <label asp-for="ConfirmPassword">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       placeholder="Confirm driver's password" />

                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="driver-form-group">

                <label class="driver-checkbox">

                    <input asp-for="IsAvailable" />

                    Driver is currently available

                </label>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="btn-primary-custom">
                    Save Driver
                </button>

                <a asp-action="Index"
                   class="btn-secondary-custom">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/driver.css"
          asp-append-version="true" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}