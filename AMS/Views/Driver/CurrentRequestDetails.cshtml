@model AMS.ViewModels.CurrentRequestDetailsViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = $"Active Dispatch - Request #{Model.Request.RequestId}";
}

<div class="driver-dashboard container py-3">

    <!-- Header Section -->
    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger-subtle text-danger border border-danger-subtle mb-2 small fw-bold">
                <span class="spinner-grow spinner-grow-sm text-danger" role="status"></span> Active Emergency Dispatch Leg
            </div>
            <h1 class="ams-page-header-title">
                Dispatch Console: Request #@Model.Request.RequestId
            </h1>
            <p class="ams-page-header-subtitle">
                Update operational status, broadcast real-time GPS telemetry, and coordinate hospital intake.
            </p>
        </div>

        <div>
            <a asp-controller="Driver" asp-action="Dashboard" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Operational Status Action Card -->
    <div class="card shadow-md border-danger border-2 mb-4 overflow-hidden bg-white">
        <div class="card-header bg-danger text-white py-3 px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-speedometer2 fs-5"></i>
                <h5 class="mb-0 fw-bold">Current Operational Status: @Model.Request.Status</h5>
            </div>
            <span class="badge bg-white text-danger fw-bold px-3 py-1">In Progress</span>
        </div>

        <div class="card-body p-4">
            <p class="text-muted mb-3">
                Advance the mission status as you proceed. Updating status transmits real-time telemetry events to the patient and hospital network.
            </p>

            <div class="d-flex flex-wrap align-items-center gap-3">
                @if (Model.Request.Status == AMS.Enums.RequestStatus.Accepted)
                {
                    <form asp-controller="Driver" asp-action="UpdateRequestStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Request.RequestId" />
                        <input type="hidden" name="newStatus" value="@AMS.Enums.RequestStatus.OnTheWay" />
                        <button type="submit" class="btn btn-ams-primary pulse-button px-4 py-3 fs-6 fw-bold">
                            <i class="bi bi-truck-front-fill me-2"></i> Depart for Patient (On The Way)
                        </button>
                    </form>
                }
                else if (Model.Request.Status == AMS.Enums.RequestStatus.OnTheWay)
                {
                    <form asp-controller="Driver" asp-action="UpdateRequestStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Request.RequestId" />
                        <input type="hidden" name="newStatus" value="@AMS.Enums.RequestStatus.ReachedPatient" />
                        <button type="submit" class="btn btn-ams-primary pulse-button px-4 py-3 fs-6 fw-bold">
                            <i class="bi bi-geo-alt-fill me-2"></i> Confirm Arrival at Patient's Location
                        </button>
                    </form>
                }
                else if (Model.Request.Status == AMS.Enums.RequestStatus.ReachedPatient)
                {
                    <form asp-controller="Driver" asp-action="UpdateRequestStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Request.RequestId" />
                        <input type="hidden" name="newStatus" value="@AMS.Enums.RequestStatus.PatientPickedUp" />
                        <button type="submit" class="btn btn-ams-primary pulse-button px-4 py-3 fs-6 fw-bold">
                            <i class="bi bi-person-check-fill me-2"></i> Patient Picked Up & Stabilized
                        </button>
                    </form>
                }
                else if (Model.Request.Status == AMS.Enums.RequestStatus.PatientPickedUp)
                {
                    if (Model.Request.HospitalId == null)
                    {
                        <div class="alert alert-info d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-hospital fs-4 text-primary"></i>
                            <div>
                                <strong>Select a Destination Hospital below</strong> before beginning transport transit.
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Driver" asp-action="UpdateRequestStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Request.RequestId" />
                            <input type="hidden" name="newStatus" value="@AMS.Enums.RequestStatus.GoingToHospital" />
                            <button type="submit" class="btn btn-ams-primary pulse-button px-4 py-3 fs-6 fw-bold">
                                <i class="bi bi-hospital-fill me-2"></i> Begin Transport to Hospital
                            </button>
                        </form>
                    }
                }
                else if (Model.Request.Status == AMS.Enums.RequestStatus.GoingToHospital)
                {
                    <form asp-controller="Driver" asp-action="UpdateRequestStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Request.RequestId" />
                        <input type="hidden" name="newStatus" value="@AMS.Enums.RequestStatus.ReachedHospital" />
                        <button type="submit" class="btn btn-ams-primary pulse-button px-4 py-3 fs-6 fw-bold">
                            <i class="bi bi-hospital me-2"></i> Reached Destination Hospital
                        </button>
                    </form>
                }
                else if (Model.Request.Status == AMS.Enums.RequestStatus.ReachedHospital)
                {
                    <form asp-controller="Driver" asp-action="UpdateRequestStatus" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Request.RequestId" />
                        <input type="hidden" name="newStatus" value="@AMS.Enums.RequestStatus.Completed" />
                        <button type="submit" class="btn btn-success px-4 py-3 fs-6 fw-bold rounded-3">
                            <i class="bi bi-check-circle-fill me-2"></i> Complete Dispatch Mission
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Suitable Hospitals Selection (If in Picked Up state and hospital not chosen) -->
    @if (Model.Hospitals.Any())
    {
        <div class="card shadow-sm border mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-hospital-fill text-danger fs-5"></i>
                    <h5 class="mb-0 fw-bold">Destination Hospital Telemetry</h5>
                </div>
                @if (Model.Request.Hospital != null)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                        <i class="bi bi-check2-circle me-1"></i> Hospital Assigned
                    </span>
                }
            </div>

            <div class="card-body p-4">
                @if (Model.Request.HospitalId == null && Model.Request.Status == AMS.Enums.RequestStatus.PatientPickedUp)
                {
                    <p class="text-muted mb-3">
                        Select an emergency-ready hospital with available ICU & general beds to admit the patient:
                    </p>

                    <form asp-controller="Driver" asp-action="SelectHospital" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Request.RequestId" />

                        <div class="hospital-selection-list mb-3">
                            @foreach (var hospital in Model.Hospitals)
                            {
                                <partial name="_HospitalSelectionItem" model="hospital" />
                            }
                        </div>

                        <button type="submit" class="btn btn-ams-primary py-2 px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Confirm Hospital Destination
                        </button>
                    </form>
                }
                else
                {
                    @if (Model.Request.Hospital != null)
                    {
                        <div class="p-3 bg-light rounded-3 border d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <span class="text-muted smaller text-uppercase fw-bold d-block">Assigned Destination Hospital</span>
                                <h5 class="fw-bold text-dark mb-1">@Model.Request.Hospital.Name</h5>
                                <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i> @Model.Request.Hospital.Address</p>
                            </div>
                            <div class="d-flex gap-3">
                                <span class="badge bg-white text-dark border p-2">
                                    General Beds: <strong>@Model.Request.Hospital.AvailableBeds</strong>
                                </span>
                                <span class="badge bg-white text-dark border p-2">
                                    ICU Beds: <strong>@Model.Request.Hospital.AvailableICUBeds</strong>
                                </span>
                                <span class="badge @(Model.Request.Hospital.EmergencyAvailable ? "bg-success" : "bg-danger") text-white p-2">
                                    @(Model.Request.Hospital.EmergencyAvailable ? "Emergency Available" : "Emergency Full")
                                </span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">
                            Hospital selection is active once patient pickup is registered.
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- Live GPS Tracking Container (Required by ambulance-live-tracking.js) -->
    <div class="card shadow-sm border mb-4"
         id="ambulanceTracking"
         data-request-id="@Model.Request.RequestId"
         data-latitude="@Model.Request.Ambulance?.Latitude"
         data-longitude="@Model.Request.Ambulance?.Longitude"
         data-pickup-latitude="@Model.Request.PickupLatitude"
         data-pickup-longitude="@Model.Request.PickupLongitude"
         data-hospital-latitude="@Model.Request.Hospital?.Latitude"
         data-hospital-longitude="@Model.Request.Hospital?.Longitude"
         data-update-url="@Url.Action("UpdateAmbulanceLocation", "Driver")">

        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-broadcast text-danger fs-5"></i>
                <h5 class="mb-0 fw-bold">Live GPS Telemetry Broadcasting</h5>
            </div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                <span class="ams-live-dot"></span> GPS Broadcast Active
            </span>
        </div>

        <div class="card-body p-4">
            <div class="position-relative">
                <div id="ambulanceLiveMap"
                     style="width: 100%; height: 440px; border-radius: 14px; border: 1px solid #cbd5e1; box-shadow: inset 0 2px 6px rgba(0,0,0,0.06);">
                </div>

                <div class="position-absolute top-0 start-0 m-3 bg-white p-2 px-3 rounded-pill shadow-sm border small fw-semibold text-secondary d-flex align-items-center gap-2">
                    <i class="bi bi-crosshair text-danger"></i>
                    <span id="trackingStatus">Acquiring Paramedic GPS Fix...</span>
                </div>
            </div>

            <form id="trackingTokenForm">
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>

    <!-- Details Grid -->
    <div class="row g-4 mb-4">
        <!-- Caller / Patient Info -->
        <div class="col-md-6">
            <div class="card shadow-sm border h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-person-fill text-primary"></i>
                    <h6 class="mb-0 fw-bold">Patient & Emergency Details</h6>
                </div>
                <div class="card-body p-3 d-flex flex-column gap-2 small">
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Patient Name</span>
                        <strong class="text-dark">@Model.Request.User?.FullName</strong>
                    </div>
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Emergency Classification</span>
                        <strong class="text-danger">@Model.Request.EmergencyType</strong>
                    </div>
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Reported Condition</span>
                        <strong class="text-dark">@Model.Request.PatientCondition</strong>
                    </div>
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Number of Patients</span>
                        <strong class="text-dark">@Model.Request.NumberOfPatients</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vehicle & Location Info -->
        <div class="col-md-6">
            <div class="card shadow-sm border h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-truck-front-fill text-success"></i>
                    <h6 class="mb-0 fw-bold">Vehicle & Pickup Coordinates</h6>
                </div>
                <div class="card-body p-3 d-flex flex-column gap-2 small">
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Ambulance Vehicle</span>
                        <strong class="text-dark">@(Model.Request.Ambulance?.VehicleNumber ?? "Not assigned")</strong>
                    </div>
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Pickup Latitude</span>
                        <code>@Model.Request.PickupLatitude</code>
                    </div>
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Pickup Longitude</span>
                        <code>@Model.Request.PickupLongitude</code>
                    </div>
                    <div class="p-2 rounded bg-light">
                        <span class="text-muted d-block smaller">Call Logged</span>
                        <span class="text-dark">@Model.Request.RequestTime.ToString("dd-MM-yyyy HH:mm:ss")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Actions Bar -->
    <div class="card shadow-sm p-4 bg-white border">
        <div class="d-flex justify-content-between align-items-center">
            <a asp-controller="Driver" asp-action="Dashboard" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Return to Driver Dashboard
            </a>

            <span class="text-muted small">
                <i class="bi bi-shield-check text-success me-1"></i> GPS telemetry active on this channel
            </span>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/driver.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@(Configuration["GoogleMaps:ApiKey"])&callback=initAmbulanceLiveMap" async defer></script>
    <script src="~/js/ambulance-live-tracking.js" asp-append-version="true"></script>
}
