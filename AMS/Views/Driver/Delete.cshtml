@model AMS.Models.Driver

@{
    ViewData["Title"] = $"Delete Driver - {Model.FullName}";
}

<div class="driver-details-page container py-3">

    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger-subtle text-danger border border-danger-subtle mb-2 small fw-bold">
                <i class="bi bi-exclamation-triangle-fill"></i> Danger Zone
            </div>
            <h1 class="ams-page-header-title text-danger">
                Delete Driver Profile
            </h1>
            <p class="ams-page-header-subtitle">
                Confirm whether you wish to permanently remove driver <strong>@Model.FullName</strong> from the paramedic roster.
            </p>
        </div>

        <div>
            <a asp-action="Index" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Drivers
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border border-danger">
                <div class="card-header bg-danger text-white py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-trash-fill fs-5"></i>
                    <h5 class="mb-0 fw-bold">Confirm Deletion</h5>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning:</strong> Deleting this driver will unassign any active ambulance vehicles and revoke their dispatch credentials.
                    </div>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Driver Full Name</span>
                            <strong class="fs-5 text-dark">@Model.FullName</strong>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Phone Number</span>
                            <span class="text-dark">@Model.PhoneNumber</span>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">License Number</span>
                            <code>@Model.LicenseNumber</code>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="ams-back-btn">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>

                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this driver?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="DriverId" />
                            <button type="submit" class="btn btn-danger px-4 py-2 fw-bold">
                                <i class="bi bi-trash-fill me-1"></i> Delete Driver
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/driver.css" asp-append-version="true" />
}
