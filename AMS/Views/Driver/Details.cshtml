@model AMS.Models.Driver

@{
    ViewData["Title"] = $"Driver Profile - {Model.FullName}";
}

<div class="driver-details-page container py-3">

    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-2 small fw-bold">
                <span class="ams-live-dot" style="background-color: #f59e0b;"></span> Paramedic Personnel Record
            </div>
            <h1 class="ams-page-header-title">
                @Model.FullName
            </h1>
            <p class="ams-page-header-subtitle">
                Commercial driver licensing, duty status, and contact telemetry.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Drivers
            </a>
            <a asp-action="Edit" asp-route-id="@Model.DriverId" class="btn btn-primary rounded-pill px-3 btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Driver
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-person-lines-fill text-primary fs-5"></i>
                    <h5 class="mb-0 fw-bold">Paramedic Driver Profile</h5>
                </div>

                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted smaller text-uppercase fw-bold d-block">Driver Record ID</span>
                                <strong class="fs-5 text-dark">#@Model.DriverId</strong>
                            </div>
                            @if (Model.IsAvailable)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                    <span class="ams-live-dot"></span> Available on Duty
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                                    <span class="ams-live-dot" style="background-color: #f59e0b;"></span> Unavailable / On Call
                                </span>
                            }
                        </div>

                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Full Legal Name</span>
                            <span class="fs-5 fw-bold text-dark">@Model.FullName</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="text-muted smaller text-uppercase fw-bold d-block">Contact Phone</span>
                                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                    {
                                        <a href="tel:@Model.PhoneNumber" class="text-primary fw-bold text-decoration-none fs-6">
                                            <i class="bi bi-telephone-fill me-1"></i> @Model.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Provided</span>
                                    }
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="text-muted smaller text-uppercase fw-bold d-block">Commercial Driver License</span>
                                    <code class="fs-6 text-dark fw-bold">@Model.LicenseNumber</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm p-4 bg-white border">
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="ams-back-btn">
                        <i class="bi bi-arrow-left"></i> Back to Drivers
                    </a>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.DriverId" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-pencil me-1"></i> Edit Driver
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.DriverId" class="btn btn-outline-danger rounded-pill px-3">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/driver.css" asp-append-version="true" />
}
