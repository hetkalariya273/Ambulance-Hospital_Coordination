@model AMS.Models.Driver

@{
    ViewData["Title"] = $"Edit Driver - {Model.FullName}";
}

<div class="driver-form-page container py-3">

    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-2 small fw-bold">
                <span class="ams-live-dot" style="background-color: #f59e0b;"></span> Paramedic Configuration
            </div>
            <h1 class="ams-page-header-title">
                Edit Driver: @Model.FullName
            </h1>
            <p class="ams-page-header-subtitle">
                Update driver contact information, licensing credentials, and duty availability status.
            </p>
        </div>

        <div>
            <a asp-action="Index" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Drivers
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-warning fs-5"></i>
                    <h5 class="mb-0 fw-bold">Update Paramedic Profile</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="DriverId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Full Legal Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person-fill text-primary"></i></span>
                                <input asp-for="FullName" class="form-control" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Contact Phone Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone-fill text-success"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LicenseNumber" class="form-label fw-bold">Commercial License Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-card-heading text-secondary"></i></span>
                                <input asp-for="LicenseNumber" class="form-control" />
                            </div>
                            <span asp-validation-for="LicenseNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <div class="form-check form-switch mb-0 d-flex align-items-center gap-3">
                                <input asp-for="IsAvailable" class="form-check-input fs-4 mt-0" type="checkbox" role="switch" id="driverEditAvailSwitch" />
                                <label class="form-check-label fw-bold text-dark cursor-pointer" for="driverEditAvailSwitch">
                                    Driver is Currently Available on Duty
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="ams-back-btn">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>

                            <button type="submit" class="btn btn-ams-primary px-4 py-2 fw-bold">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/driver.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
