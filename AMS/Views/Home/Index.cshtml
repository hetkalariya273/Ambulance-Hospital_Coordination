@{
    ViewData["Title"] = "Emergency Ambulance & Hospital Coordination";
}

<!-- Hero Section -->
<div class="ams-hero-section py-5 mb-5 position-relative overflow-hidden rounded-4">
    <div class="container position-relative z-1 py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger-subtle border border-danger-subtle text-danger mb-3">
                    <span class="ams-live-dot"></span>
                    <span class="small fw-bold text-uppercase tracking-wider">24/7 Rapid Medical Response Dispatch</span>
                </div>
                <h1 class="display-4 fw-extrabold text-white mb-3">
                    Every Second Counts.<br />
                    <span class="text-danger">Rapid Ambulance</span> & Hospital Telemetry.
                </h1>
                <p class="lead text-white-50 mb-4 pe-lg-4">
                    Instant emergency dispatch connecting distress callers, nearby paramedics, and real-time hospital bed & ICU availability through live GPS telemetry.
                </p>

                <!-- Immediate Action Buttons -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="AmbulanceRequest" asp-action="Create" class="btn btn-ams-primary pulse-button px-4 py-3 fs-5 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Request Ambulance Now
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light px-4 py-3 fs-6 fw-semibold rounded-3 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-person-badge me-1"></i> Personnel Sign In
                    </a>
                </div>

                <!-- Emergency Fast Dial Callout -->
                <div class="d-flex flex-wrap align-items-center gap-3 pt-3 border-top border-white border-opacity-10">
                    <span class="text-white-50 small">Direct Emergency Helplines:</span>
                    <a href="tel:108" class="badge bg-danger text-white text-decoration-none px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-telephone-fill me-1"></i> 108 (Ambulance)
                    </a>
                    <a href="tel:112" class="badge bg-primary text-white text-decoration-none px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-shield-shaded me-1"></i> 112 (National Emergency)
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <!-- Interactive Quick Dispatch Radar Card -->
                <div class="card shadow-lg border-0 bg-dark text-white rounded-4 overflow-hidden border border-secondary border-opacity-25">
                    <div class="card-header bg-black bg-opacity-40 py-3 px-4 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-broadcast text-danger fs-5"></i>
                            <span class="fw-bold text-white">Live Coordination Telemetry</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Online</span>
                    </div>

                    <div class="card-body p-4">
                        <div class="d-flex flex-column gap-3">
                            <div class="p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ams-stat-icon-wrapper" style="--stat-bg: rgba(225,29,72,0.15); --stat-color: #f43f5e;">
                                        <i class="bi bi-truck-front-fill"></i>
                                    </div>
                                    <div>
                                        <div class="text-white-50 smaller text-uppercase fw-bold">Live GPS Telemetry</div>
                                        <div class="fw-bold text-white">Continuous Map Tracking</div>
                                    </div>
                                </div>
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            </div>

                            <div class="p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ams-stat-icon-wrapper" style="--stat-bg: rgba(14,165,233,0.15); --stat-color: #38bdf8;">
                                        <i class="bi bi-hospital"></i>
                                    </div>
                                    <div>
                                        <div class="text-white-50 smaller text-uppercase fw-bold">Hospital Telemetry</div>
                                        <div class="fw-bold text-white">Emergency & ICU Beds</div>
                                    </div>
                                </div>
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            </div>

                            <div class="p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ams-stat-icon-wrapper" style="--stat-bg: rgba(16,185,129,0.15); --stat-color: #34d399;">
                                        <i class="bi bi-speedometer2"></i>
                                    </div>
                                    <div>
                                        <div class="text-white-50 smaller text-uppercase fw-bold">Average Dispatch</div>
                                        <div class="fw-bold text-white">&lt; 3 Minutes Response</div>
                                    </div>
                                </div>
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-center">
                            <span class="text-white-50 small">Secured Real-Time WebSocket Telemetry powered by SignalR</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Portals & Role Navigation Cards -->
<div class="container mb-5">
    <div class="text-center mb-5">
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill mb-2 fw-bold text-uppercase">Role-Based Access</span>
        <h2 class="fw-bold text-dark display-6">Dedicated Coordination Portals</h2>
        <p class="text-muted col-md-7 mx-auto">
            Choose your portal below to access customized dashboards, live telemetry, and management tools.
        </p>
    </div>

    <div class="row g-4">
        <!-- Patient Portal Card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border ams-card-hover text-start p-2">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="ams-stat-icon-wrapper mb-3" style="--stat-bg: #fee2e2; --stat-color: #e11d48; width: 60px; height: 60px; font-size: 1.8rem;">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Patient Portal</h4>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Request an emergency ambulance immediately with one click, pin your exact location on Google Maps, and track arrival en route in real time.
                    </p>
                    <div class="d-flex flex-column gap-2 mt-auto">
                        <a asp-controller="AmbulanceRequest" asp-action="Create" class="btn btn-ams-primary w-100">
                            <i class="bi bi-plus-circle me-1"></i> Request Ambulance
                        </a>
                        <a asp-controller="Patient" asp-action="Index" class="btn btn-outline-secondary w-100 btn-sm">
                            <i class="bi bi-speedometer2 me-1"></i> Patient Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Driver Portal Card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border ams-card-hover text-start p-2">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="ams-stat-icon-wrapper mb-3" style="--stat-bg: #e0f2fe; --stat-color: #0284c7; width: 60px; height: 60px; font-size: 1.8rem;">
                        <i class="bi bi-truck-front-fill"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Driver Console</h4>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Receive instant sound and visual dispatch notifications for nearby emergency calls, review patient conditions, and update live GPS status en route.
                    </p>
                    <div class="d-flex flex-column gap-2 mt-auto">
                        <a asp-controller="Driver" asp-action="Dashboard" class="btn btn-primary w-100 fw-bold">
                            <i class="bi bi-compass me-1"></i> Open Driver Dashboard
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary w-100 btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Driver Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin & Hospital Portal Card -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border ams-card-hover text-start p-2">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="ams-stat-icon-wrapper mb-3" style="--stat-bg: #f3e8ff; --stat-color: #7e22ce; width: 60px; height: 60px; font-size: 1.8rem;">
                        <i class="bi bi-shield-shaded"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Hospital & Admin Dispatch</h4>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Oversee the entire ambulance fleet, manage hospital bed availability and ICU capacity, assign vehicles, and monitor dispatch history.
                    </p>
                    <div class="d-flex flex-column gap-2 mt-auto">
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-dark w-100 fw-bold">
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> Admin Command Center
                        </a>
                        <a asp-controller="Hospital" asp-action="Index" class="btn btn-outline-secondary w-100 btn-sm">
                            <i class="bi bi-hospital me-1"></i> Hospitals Directory
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Key Platform Pillars -->
<div class="container mb-5 py-4 border-top">
    <div class="row g-4 text-center">
        <div class="col-md-3">
            <div class="p-3">
                <i class="bi bi-geo-alt-fill text-danger fs-1 mb-2 d-inline-block"></i>
                <h5 class="fw-bold">Accurate Geolocation</h5>
                <p class="text-muted small">Pinpoint patient pickup coordinates with precision using Google Maps integration.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3">
                <i class="bi bi-broadcast text-primary fs-1 mb-2 d-inline-block"></i>
                <h5 class="fw-bold">Real-Time Telemetry</h5>
                <p class="text-muted small">Instant driver dispatch and status tracking powered by Microsoft SignalR WebSockets.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3">
                <i class="bi bi-hospital-fill text-success fs-1 mb-2 d-inline-block"></i>
                <h5 class="fw-bold">Bed Availability</h5>
                <p class="text-muted small">Ensure arriving ambulances route to hospitals with confirmed emergency and ICU bed space.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3">
                <i class="bi bi-shield-check text-warning fs-1 mb-2 d-inline-block"></i>
                <h5 class="fw-bold">Role-Based Security</h5>
                <p class="text-muted small">Strict ASP.NET Identity role enforcement for Patients, Drivers, and Administrators.</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .ams-hero-section {
            background: linear-gradient(135deg, #090d16 0%, #1e1b4b 50%, #0f172a 100%);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .tracking-wider {
            letter-spacing: 0.08em;
        }

        .fw-extrabold {
            font-weight: 800;
        }
    </style>
}
