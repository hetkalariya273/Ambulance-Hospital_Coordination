@model AMS.Models.Hospital

@{
    ViewData["Title"] = "Add Hospital Facility";
}

<div class="hospital-form-page container py-3">

    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-success-subtle text-success border border-success-subtle mb-2 small fw-bold">
                <span class="ams-live-dot" style="background-color: #10b981;"></span> Facility Registration
            </div>
            <h1 class="ams-page-header-title">
                Add Hospital Facility
            </h1>
            <p class="ams-page-header-subtitle">
                Enter hospital location, contact numbers, and initial emergency and ICU bed telemetry.
            </p>
        </div>

        <div>
            <a asp-action="Index" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Hospitals
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-hospital text-success fs-5"></i>
                    <h5 class="mb-0 fw-bold">Facility Telemetry & Information</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Hospital Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-building text-primary"></i></span>
                                <input asp-for="Name" class="form-control" placeholder="e.g. City General Trauma Center" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">Physical Address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt-fill text-danger"></i></span>
                                <input asp-for="Address" class="form-control" placeholder="e.g. 102 Healthcare Avenue, Medical District" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Emergency Intake Phone Number <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone-fill text-success"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. +1 555-0199 or 108" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="Latitude" class="form-label fw-bold">GPS Latitude <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><code>Lat</code></span>
                                    <input asp-for="Latitude" type="number" step="any" class="form-control" placeholder="e.g. 22.3072" />
                                </div>
                                <span asp-validation-for="Latitude" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-sm-6">
                                <label asp-for="Longitude" class="form-label fw-bold">GPS Longitude <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><code>Lng</code></span>
                                    <input asp-for="Longitude" type="number" step="any" class="form-control" placeholder="e.g. 73.1812" />
                                </div>
                                <span asp-validation-for="Longitude" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="AvailableBeds" class="form-label fw-bold">General Beds Available</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-hospital text-muted"></i></span>
                                    <input asp-for="AvailableBeds" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="AvailableBeds" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-sm-6">
                                <label asp-for="AvailableICUBeds" class="form-label fw-bold">ICU Beds Available</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-heart-pulse text-danger"></i></span>
                                    <input asp-for="AvailableICUBeds" type="number" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="AvailableICUBeds" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <div class="form-check form-switch mb-0 d-flex align-items-center gap-3">
                                <input asp-for="EmergencyAvailable" class="form-check-input fs-4 mt-0" type="checkbox" role="switch" id="emergencySwitch" />
                                <label class="form-check-label fw-bold text-dark cursor-pointer" for="emergencySwitch">
                                    Emergency Ward is Open & Accepting Ambulances
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="ams-back-btn">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>

                            <button type="submit" class="btn btn-ams-primary px-4 py-2 fw-bold">
                                <i class="bi bi-check2-circle me-1"></i> Register Hospital
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hospital.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
