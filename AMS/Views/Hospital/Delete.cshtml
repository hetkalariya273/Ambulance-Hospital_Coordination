@model AMS.Models.Hospital

@{
    ViewData["Title"] = $"Delete Hospital - {Model.Name}";
}

<div class="hospital-form-page container py-3">

    <div class="ams-page-header">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger-subtle text-danger border border-danger-subtle mb-2 small fw-bold">
                <i class="bi bi-exclamation-triangle-fill"></i> Danger Zone
            </div>
            <h1 class="ams-page-header-title text-danger">
                Delete Hospital Facility
            </h1>
            <p class="ams-page-header-subtitle">
                Confirm whether you wish to permanently decommission this healthcare center from the ambulance dispatch network.
            </p>
        </div>

        <div>
            <a asp-action="Index" class="ams-back-btn">
                <i class="bi bi-arrow-left"></i> Back to Hospitals
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border border-danger">
                <div class="card-header bg-danger text-white py-3 d-flex align-items-center gap-2">
                    <i class="bi bi-trash-fill fs-5"></i>
                    <h5 class="mb-0 fw-bold">Confirm Decommissioning</h5>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning:</strong> Deleting this facility will immediately remove it from driver intake options and live bed tracking telemetry.
                    </div>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Facility Name</span>
                            <strong class="fs-5 text-dark">@Model.Name</strong>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Address</span>
                            <span class="text-dark">@Model.Address</span>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted smaller text-uppercase fw-bold d-block">Intake Phone</span>
                            <span class="text-dark">@Model.PhoneNumber</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="ams-back-btn">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>

                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you completely sure you want to delete this hospital?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="HospitalId" />
                            <button type="submit" class="btn btn-danger px-4 py-2 fw-bold">
                                <i class="bi bi-trash-fill me-1"></i> Delete Hospital
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hospital.css" asp-append-version="true" />
}
