@model ErrorViewModel

@{
    ViewData["Title"] = "System Error";
}

<div class="container py-5 text-center">

    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-white">
                <div class="ams-stat-icon-wrapper mx-auto mb-4" style="--stat-bg: #fee2e2; --stat-color: #e11d48; width: 72px; height: 72px; font-size: 2.2rem;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <h2 class="fw-bold text-dark mb-2">Coordination Error Encountered</h2>
                <p class="text-muted mb-4">
                    An unexpected exception occurred while processing this telemetry action. Please try again or return to the main dashboard.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="p-3 bg-light rounded-3 border mb-4 text-start">
                        <span class="text-muted smaller text-uppercase fw-bold d-block">Error Tracking ID</span>
                        <code class="text-danger fw-bold">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-ams-primary py-2 fw-bold">
                        <i class="bi bi-house-door-fill me-1"></i> Return to Homepage
                    </a>
                    <a href="javascript:history.back()" class="ams-back-btn justify-content-center py-2">
                        <i class="bi bi-arrow-left"></i> Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
