@model AMS.Models.Hospital

<label class="card shadow-sm border p-3 mb-2 rounded-3 ams-card-hover d-flex flex-row align-items-center gap-3 cursor-pointer bg-white">
    <input type="radio"
           name="hospitalId"
           value="@Model.HospitalId"
           class="form-check-input mt-0 fs-5"
           required />

    <div class="flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <h6 class="fw-bold text-dark mb-0">@Model.Name</h6>
            @if (Model.EmergencyAvailable)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                    <i class="bi bi-check-circle-fill me-1"></i> Emergency Ready
                </span>
            }
            else
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                    <i class="bi bi-x-circle me-1"></i> Emergency Full
                </span>
            }
        </div>

        <p class="text-muted smaller mb-2">
            <i class="bi bi-geo-alt me-1"></i> @Model.Address
        </p>

        <div class="d-flex flex-wrap gap-3 small">
            <span class="badge bg-light text-dark border">
                <i class="bi bi-hospital me-1 text-primary"></i> General Beds: <strong>@Model.AvailableBeds</strong>
            </span>
            <span class="badge bg-light text-dark border">
                <i class="bi bi-heart-pulse me-1 text-danger"></i> ICU Beds: <strong>@Model.AvailableICUBeds</strong>
            </span>
            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
            {
                <span class="badge bg-light text-dark border">
                    <i class="bi bi-telephone me-1 text-muted"></i> @Model.PhoneNumber
                </span>
            }
        </div>
    </div>
</label>
