@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var userRole = "";
    if (User.IsInRole("Admin")) { userRole = "Admin"; }
    else if (User.IsInRole("Driver")) { userRole = "Driver"; }
    else if (User.IsInRole("Patient")) { userRole = "Patient"; }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AMS Emergency Dispatch</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap & Custom CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AMS.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ams-body">
    <!-- Emergency Top Status Bar -->
    <div class="ams-top-banner">
        <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="ams-live-indicator">
                    <span class="ams-live-dot"></span>
                </span>
                <span class="ams-top-text">
                    <strong>Emergency Dispatch Network:</strong> Active & Monitored 24/7
                </span>
            </div>
            <div class="d-flex align-items-center gap-3 ams-top-contacts">
                <span><i class="bi bi-telephone-fill text-danger me-1"></i> Emergency Hotline: <strong>108 / 112</strong></span>
                <span class="d-none d-md-inline text-muted-opacity">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-shield-check text-success me-1"></i> Priority Medical Routing</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="ams-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark ams-navbar">
            <div class="container-fluid px-lg-4">
                <!-- Brand Logo -->
                <a class="navbar-brand ams-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="ams-logo-icon">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="ams-brand-title">AMS <span class="ams-brand-accent">Emergency</span></span>
                        <span class="ams-brand-subtitle">Ambulance & Hospital Coordination</span>
                    </div>
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler ams-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#amsNavbarCollapse" 
                        aria-controls="amsNavbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>

                <!-- Navigation Menu -->
                <div class="collapse navbar-collapse" id="amsNavbarCollapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ams-nav-links">
                        <li class="nav-item">
                            <a class="nav-link ams-nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i> Home
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Admin" asp-action="Requests">
                                        <i class="bi bi-card-checklist me-1"></i> All Requests
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Hospital" asp-action="Index">
                                        <i class="bi bi-hospital me-1"></i> Hospitals
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Ambulance" asp-action="Index">
                                        <i class="bi bi-truck-front-fill me-1"></i> Ambulances
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Driver" asp-action="Index">
                                        <i class="bi bi-person-badge-fill me-1"></i> Drivers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Admin" asp-action="Users">
                                        <i class="bi bi-people-fill me-1"></i> Users
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Driver"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Driver" asp-action="Dashboard">
                                        <i class="bi bi-speedometer me-1"></i> Driver Dashboard
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Patient"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="Patient" asp-action="Index">
                                        <i class="bi bi-grid-fill me-1"></i> My Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link ams-nav-link" asp-controller="AmbulanceRequest" asp-action="MyRequests">
                                        <i class="bi bi-clock-history me-1"></i> My Requests
                                    </a>
                                </li>
                                <li class="nav-item ms-lg-2">
                                    <a class="btn ams-btn-emergency btn-sm pulse-button" asp-controller="AmbulanceRequest" asp-action="Create">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Request Ambulance
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn ams-btn-emergency btn-sm pulse-button" asp-controller="AmbulanceRequest" asp-action="Create">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Emergency Request
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- User Account / Actions -->
                    <div class="d-flex align-items-center gap-3 ams-auth-section">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="ams-user-badge d-flex align-items-center gap-2">
                                <div class="ams-avatar">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <div class="d-flex flex-column text-start">
                                    <span class="ams-user-name">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                    <span class="ams-role-pill role-@userRole.ToLower()">@userRole</span>
                                </div>
                            </div>

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn ams-btn-logout btn-sm" title="Sign out">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn ams-btn-login btn-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn ams-btn-register btn-sm">
                                <i class="bi bi-person-plus-fill me-1"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <div class="ams-main-wrapper">
        <main role="main" class="ams-main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Modern Emergency Coordination Footer -->
    <footer class="ams-footer">
        <div class="container-fluid px-lg-4">
            <div class="row g-4 py-4 border-bottom border-secondary border-opacity-25">
                <div class="col-lg-5 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="ams-logo-icon ams-logo-icon-sm">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <span class="fs-5 fw-bold text-white">AMS Emergency Coordination</span>
                    </div>
                    <p class="text-white-50 small mb-3">
                        A real-time emergency healthcare dispatch and coordination platform connecting patients, ambulance drivers, and hospitals with live GPS tracking and bed availability telemetry.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Real-Time Telemetry
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-shield-check me-1"></i> 99.9% Uptime SLA
                        </span>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Emergency Quick Links</h6>
                    <ul class="list-unstyled ams-footer-links small mb-0">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1 text-danger"></i> Home & Overview</a></li>
                        <li><a asp-controller="AmbulanceRequest" asp-action="Create"><i class="bi bi-chevron-right me-1 text-danger"></i> Instant Ambulance Booking</a></li>
                        <li><a asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1 text-danger"></i> Personnel Portal Login</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-chevron-right me-1 text-danger"></i> Privacy Policy & Terms</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12">
                    <h6 class="text-white fw-bold mb-3">Emergency Dispatch Helplines</h6>
                    <div class="ams-hotline-cards d-flex flex-column gap-2">
                        <div class="ams-hotline-item d-flex align-items-center justify-content-between p-2 rounded">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-telephone-inbound-fill text-danger fs-5"></i>
                                <div>
                                    <div class="fw-bold text-white small">Emergency Ambulance</div>
                                    <div class="text-white-50 smaller">Instant Medical Response</div>
                                </div>
                            </div>
                            <span class="badge bg-danger fs-6 px-3 py-2">108</span>
                        </div>
                        <div class="ams-hotline-item d-flex align-items-center justify-content-between p-2 rounded">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-shaded text-primary fs-5"></i>
                                <div>
                                    <div class="fw-bold text-white small">National Emergency</div>
                                    <div class="text-white-50 smaller">All-in-One Helpline</div>
                                </div>
                            </div>
                            <span class="badge bg-primary fs-6 px-3 py-2">112</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center py-3 text-white-50 small">
                <div>
                    &copy; @DateTime.Now.Year <strong>AMS</strong> - Ambulance Management System for Emergency. All Rights Reserved.
                </div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none hover-white">Privacy Policy</a>
                    <span>&bull;</span>
                    <span class="text-success"><i class="bi bi-circle-fill smaller me-1"></i> Systems Operational</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
