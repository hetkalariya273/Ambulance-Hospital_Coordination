@model List<AMS.Models.AmbulanceRequest>

<div id="nearbyRequestsContent"
     data-request-count="@Model.Count">

    @if (Model.Any())
    {
        <div class="request-list">
            @foreach (var request in Model)
            {
                <div data-request-card>
                    <partial name="_RequestCard" model="request" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 bg-light rounded-3 border">
            <i class="bi bi-radar text-muted fs-2 mb-2 d-block"></i>
            <span class="fw-bold text-dark d-block">Monitoring Live Requests</span>
            <span class="text-muted smaller">Standing by. Incoming emergency ambulance requests will appear here automatically via SignalR.</span>
        </div>
    }

</div>
