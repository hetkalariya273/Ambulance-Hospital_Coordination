
@model List<AMS.Models.AmbulanceRequest>

<div id="nearbyRequestsContent"
     data-request-count="@Model.Count">

    @if (Model.Any())
    {
        <div class="request-list">
            @foreach (var request in Model)
            {
                <div data-request-card>
                    <partial name="_RequestCard" model="request" />
                </div>
            }
        </div>
    }
    else
    {
        <p class="empty-message">
            No new requests available.
        </p>
    }

</div>
