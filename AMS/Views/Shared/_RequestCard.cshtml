@model AMS.Models.AmbulanceRequest

<div class="card shadow-sm border ams-card-hover rounded-3 p-3 bg-white mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                <i class="bi bi-broadcast me-1"></i> Active Signal
            </span>
            <span class="fw-bold fs-6 text-dark">Request #@Model.RequestId</span>
        </div>

        <span class="badge bg-primary text-white rounded-pill px-3 py-1">
            @Model.Status
        </span>
    </div>

    <div class="row g-2 mb-3 small">
        <div class="col-6">
            <div class="p-2 rounded bg-light">
                <span class="text-muted d-block smaller">Emergency Type</span>
                <strong class="text-danger">@Model.EmergencyType</strong>
            </div>
        </div>
        <div class="col-6">
            <div class="p-2 rounded bg-light">
                <span class="text-muted d-block smaller">Patient Condition</span>
                <strong class="text-dark">@Model.PatientCondition</strong>
            </div>
        </div>
        <div class="col-6">
            <div class="p-2 rounded bg-light">
                <span class="text-muted d-block smaller">Patients</span>
                <strong class="text-dark">@Model.NumberOfPatients</strong>
            </div>
        </div>
        <div class="col-6">
            <div class="p-2 rounded bg-light">
                <span class="text-muted d-block smaller">Request Time</span>
                <strong class="text-dark">@Model.RequestTime.ToString("HH:mm")</strong>
            </div>
        </div>
    </div>

    <div>
        <a asp-controller="Driver"
           asp-action="RequestDetails"
           asp-route-id="@Model.RequestId"
           class="btn btn-ams-primary w-100 rounded-pill py-2 fw-bold">
            <i class="bi bi-eye-fill me-1"></i> Inspect & Accept Request
        </a>
    </div>
</div>
